{
  "name": "@vyzus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/seed-demo.ts --format esm --sourcemap",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/websocket": "^11.3.0",
    "@vyzus/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "5.80.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vyzus/worker": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
