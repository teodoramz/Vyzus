{
  "name": "@vyzus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/seed-demo.ts --format esm --sourcemap",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "@vyzus/shared": "workspace:*",
    "argon2": "^0.41.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vyzus/worker": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.1"
  }
}
