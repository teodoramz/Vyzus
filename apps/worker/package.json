{
  "name": "@vyzus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sandbox/runner-harness.ts src/testkit.ts --format esm --sourcemap --dts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vyzus/shared": "workspace:*",
    "bullmq": "5.80.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
