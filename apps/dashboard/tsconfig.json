{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
