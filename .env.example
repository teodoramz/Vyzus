# --- copy to .env and fill in ---

# Postgres
POSTGRES_DB=vyzus
POSTGRES_USER=vyzus
POSTGRES_PASSWORD=change-me-strong

# Auth
JWT_SECRET=change-me-64-random-chars
# 32-byte hex key for AES-256-GCM encryption of app credentials:  openssl rand -hex 32
ENCRYPTION_KEY=

# Public URL of the dashboard (used in alert links)
PUBLIC_URL=http://localhost:8080
DASHBOARD_PORT=8080

# Worker
WORKER_CONCURRENCY=4
