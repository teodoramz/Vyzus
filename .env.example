# --- copy to .env and fill in ---

# Postgres
POSTGRES_DB=vyzus
POSTGRES_USER=vyzus
POSTGRES_PASSWORD=change-me-strong

# Auth
JWT_SECRET=change-me-64-random-chars
# 32-byte hex key for AES-256-GCM encryption of app credentials:  openssl rand -hex 32
ENCRYPTION_KEY=

# Public URL of the dashboard. Used in alert links, and its scheme decides
# whether the refresh cookie is marked Secure — set it to the https:// address
# when deploying with docker-compose.tls.yml.
PUBLIC_URL=http://localhost:8080
DASHBOARD_PORT=8080

# TLS deployment only (docker-compose.tls.yml). See docs/05-infrastructure.md.
# HTTP_PORT=80
# HTTPS_PORT=443

# Worker
WORKER_CONCURRENCY=4
