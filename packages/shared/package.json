{
  "name": "@vyzus/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./crypto": {
      "types": "./dist/node/crypto.d.ts",
      "import": "./dist/node/crypto.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/db/index.ts src/node/crypto.ts --format esm --dts",
    "dev": "tsup src/index.ts src/db/index.ts src/node/crypto.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
